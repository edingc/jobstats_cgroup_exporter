[Unit]
Description=Jobstats cgroup v2 exporter for Slurm
Documentation=https://github.com/edingc/jobstats_cgroup_exporter
After=network.service

[Service]
AmbientCapabilities=CAP_SYS_PTRACE
Restart=always
User=prometheus
EnvironmentFile=/etc/default/jobstats_cgroup_exporter
ExecStart=/usr/local/bin/jobstats_cgroup_exporter $ARGS
ExecReload=/bin/kill -HUP $MAINPID
TimeoutStopSec=20s
SendSIGKILL=no

[Install]
WantedBy=multi-user.target
